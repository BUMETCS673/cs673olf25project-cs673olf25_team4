# Development SSL Configuration for BeatMap Backend

# Environment Configuration
ENVIRONMENT=development

# SSL Certificate Configuration (Development)
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/dev/server.crt
SSL_KEY_PATH=/app/ssl/dev/server.key
SSL_PORT=8443

# HTTPS Enforcement (Disabled for development)
FORCE_HTTPS=false
HTTPS_PORT=443

# Security Headers Configuration (Relaxed for development)
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# Content Security Policy (Permissive for development)
CSP_ENABLED=true
CSP_DEFAULT_SRC='self','unsafe-inline','unsafe-eval'
CSP_SCRIPT_SRC='self','unsafe-inline','unsafe-eval'
CSP_STYLE_SRC='self','unsafe-inline'
CSP_CONNECT_SRC='self',localhost:*,127.0.0.1:*
CSP_REPORT_URI=

# Security Headers (Development friendly)
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=true
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY_ENABLED=false

# CORS Configuration (Development)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_HEADERS=*

# Server Configuration
BEATMAP_HOST=127.0.0.1
BEATMAP_PORT=8000