# SSL/TLS Configuration Template for BeatMap Backend
# Copy this file to .env.ssl and configure for your environment

# Environment Configuration
ENVIRONMENT=development

# SSL Certificate Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/app/ssl/dev/server.crt
SSL_KEY_PATH=/app/ssl/dev/server.key
SSL_PORT=8443

# HTTPS Enforcement
FORCE_HTTPS=false
HTTPS_PORT=443

# Security Headers Configuration
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Content Security Policy
CSP_ENABLED=true
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self','unsafe-inline'
CSP_STYLE_SRC='self','unsafe-inline'
CSP_CONNECT_SRC='self'
CSP_REPORT_URI=

# Security Headers
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=true
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY_ENABLED=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Server Configuration
BEATMAP_HOST=127.0.0.1
BEATMAP_PORT=8000