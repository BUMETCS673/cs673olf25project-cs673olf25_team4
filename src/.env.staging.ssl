# Staging/Test SSL Configuration for BeatMap Backend (testbeatmap.com)

# Environment Configuration
ENVIRONMENT=staging

# SSL Certificate Configuration (Staging)
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/testbeatmap/server.crt
SSL_KEY_PATH=/app/ssl/testbeatmap/server.key
SSL_PORT=8443

# HTTPS Enforcement (Enabled for staging)
FORCE_HTTPS=true
HTTPS_PORT=443

# Security Headers Configuration (Production-like)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Content Security Policy (Secure for staging)
CSP_ENABLED=true
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self','unsafe-inline'
CSP_CONNECT_SRC='self',https://testbeatmap.com
CSP_REPORT_URI=https://testbeatmap.com/csp-report

# Security Headers (Production-like)
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=true
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY_ENABLED=true

# CORS Configuration (Staging - HTTPS only)
CORS_ORIGINS=https://testbeatmap.com,https://localhost:3000,https://127.0.0.1:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Server Configuration
BEATMAP_HOST=0.0.0.0
BEATMAP_PORT=8000