# Development SSL Configuration Template
# Copy to .env.ssl for local development

# SSL Settings
SSL_ENABLED=true
SSL_CERT_PATH=./ssl/dev/server.crt
SSL_KEY_PATH=./ssl/dev/server.key
SSL_DH_PATH=./ssl/dev/dhparam.pem

# HTTPS Enforcement (disabled for development)
FORCE_HTTPS=false
HSTS_ENABLED=false

# Environment
ENVIRONMENT=development
NODE_ENV=development

# Server Configuration
BEATMAP_HOST=127.0.0.1
BEATMAP_PORT=8000
BEATMAP_HTTPS_PORT=8443