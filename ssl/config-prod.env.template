# Production SSL Configuration Template
# Copy to .env.ssl on production server

# SSL Settings (updated after running setup-production-ssl.sh)
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/production/server.crt
SSL_KEY_PATH=/app/ssl/production/server.key
SSL_DH_PATH=/app/ssl/production/dhparam.pem

# HTTPS Enforcement
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=63072000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Server Configuration
BEATMAP_HOST=0.0.0.0
BEATMAP_PORT=8000
BEATMAP_HTTPS_PORT=8443

# Domain
DOMAIN=beatmap.live