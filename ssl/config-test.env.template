# Test Server SSL Configuration Template
# Copy to .env.ssl on test server

# SSL Settings (updated after running setup-testbeatmap-ssl.sh)
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/testbeatmap/server.crt
SSL_KEY_PATH=/app/ssl/testbeatmap/server.key
SSL_DH_PATH=/app/ssl/testbeatmap/dhparam.pem

# HTTPS Enforcement
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Environment
ENVIRONMENT=staging
NODE_ENV=production

# Server Configuration
BEATMAP_HOST=0.0.0.0
BEATMAP_PORT=8000
BEATMAP_HTTPS_PORT=8443

# Domain
DOMAIN=testbeatmap.com